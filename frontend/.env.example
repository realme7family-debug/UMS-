# api   = use the Node/Express backend (default)
# local = run without backend, data stored in the browser (same as `npm run dev:offline`)
VITE_DATA_MODE=api

# Leave empty in development (Vite proxies /api to localhost:5000).
# For a deployed backend set the full origin, e.g. https://ums-api.onrender.com
VITE_SERVER_URL=
